# Bitrix24 MCP Server Configuration

# Required: Your Bitrix24 inbound webhook URL
# Format: https://{domain}.bitrix24.com/rest/{user_id}/{webhook_token}/
# 
# How to get this URL:
# 1. Go to Bitrix24 → Developer resources → Other → Inbound webhook
# 2. Create a new webhook with permissions: tasks (read, write)
# 3. Copy the full webhook URL
BITRIX_WEBHOOK_URL=https://your-domain.bitrix24.com/rest/1/your-webhook-token/

# Optional: Log level (debug, info, warning, error)
LOG_LEVEL=info

# Optional transport startup config
# Default is stdio. Set to streamable-http (or sse/http) to expose an HTTP endpoint.
BITRIX_MCP_TRANSPORT=stdio

# Optional HTTP transport settings (used when transport is sse/http/streamable-http)
BITRIX_MCP_HOST=127.0.0.1
BITRIX_MCP_PORT=8000
BITRIX_MCP_PATH=/mcp

# Optional streamable-http behavior flags (true/false)
BITRIX_MCP_JSON_RESPONSE=false
BITRIX_MCP_STATELESS_HTTP=false
